# Copy to `.env` and fill values from https://platforms.e.gov.ph/dashboard only.
# Never commit real secrets.

PORT=8787

# Optional local / internal
# LLM_BASE_URL=http://127.0.0.1:11434
# DATABASE_URL=

# ── eGov SSO ────────────────────────────────────────────────────────────────
EGOV_SSO_BASE_URL=https://hackathon-sso.e.gov.ph
EGOV_SSO_PARTNER_CODE=
EGOV_SSO_PARTNER_SECRET=
# Public widget identifier; falls back to partner code for the hackathon setup.
EGOV_SSO_CLIENT_ID=
# Public HTTPS deployment hosting /api/auth/egov/exchange for the Java APK.
EGOV_SSO_API_BASE_URL=
# Optional; the application backend defaults to the official authentication scope.
# EGOV_SSO_SCOPE=SSO_AUTHENTICATION

# ── eVerify (NIDAS) ─────────────────────────────────────────────────────────
EVERIFY_BASE_URL=https://hackathon-everify-api.e.gov.ph
EVERIFY_CLIENT_ID=
EVERIFY_CLIENT_SECRET=
# Web SDK pubKey for window.eKYC().start({ pubKey }) — client-safe; never put client_secret on device
EVERIFY_PUBLIC_KEY=

# ── Face Liveness API (pass = SUCCEEDED && confidence >= 95.0) ──────────────
# Separate from eVerify Face Liveness Web SDK (see docs/platform-apis.md §2 / §8)
FACE_LIVENESS_BASE_URL=https://hackathon-face-liveness-api.e.gov.ph
FACE_LIVENESS_API_KEY=

# ── eMessage ────────────────────────────────────────────────────────────────
EMESSAGE_BASE_URL=https://ws-message.e.gov.ph
EMESSAGE_AUTH_TOKEN=

# ── eGov AI (access_code → Bearer via POST /api/v1/egov/integration/token) ──
EGOV_AI_BASE_URL=https://egov-ai-core-ws.oueg.info
# Dashboard access_code (preferred); EGOV_AI_API_KEY still accepted as alias
EGOV_AI_ACCESS_CODE=
# EGOV_AI_API_KEY=

# ── eGovPay (X-eGovPay-Token; digest = HMAC-SHA256("$amount|$txnid", token)) ─
EGOVPAY_BASE_URL=https://egovpay-pgi-ws-dev.oueg.info
# Dashboard name preferred; EGOVPAY_TOKEN still accepted (use test_… for sandbox)
EGOVPAY_API_KEY=
EGOVPAY_SETTLEMENT_TEMPLATE_UUID=
# Optional digest key override; if empty, adapter uses API key / token
# EGOVPAY_HMAC_SECRET=
# EGOVPAY_TOKEN=
# Defaults when BANGON disburse omits redirect/callback in the body
# EGOVPAY_REDIRECT_URL=https://localhost/bangon/pay/return
# EGOVPAY_CALLBACK_URL=https://localhost/bangon/pay/callback

# ── eGovChain JSON-RPC (chain 13371) ────────────────────────────────────────
EGOVCHAIN_RPC_URL=https://hackathon-blockchain.e.gov.ph
EGOVCHAIN_CHAIN_ID=13371
# Optional dashboard-documented JSON-RPC method to submit the match hash (omit = local hash only)
# EGOVCHAIN_ANCHOR_METHOD=
# Tolvaris card registry. Keep signer and HMAC secret server-side only.
TOLVARIS_REGISTRY_ADDRESS=
TOLVARIS_TRANSPARENCY_REGISTRY_ADDRESS=
TOLVARIS_GENERAL_LEDGER_ADDRESS=
TOLVARIS_BENEFIT_REGISTRY_ADDRESS=
TOLVARIS_REPORT_REGISTRY_ADDRESS=
TOLVARIS_PAYMENT_PROOF_REGISTRY_ADDRESS=
TOLVARIS_DOCUMENT_PROOF_REGISTRY_ADDRESS=
EGOVCHAIN_SIGNER_PRIVATE_KEY=
TOLVARIS_OWNER_HMAC_SECRET=
# JSON map: key ID -> {"agencyCode":"DBM","publicKeyPem":"-----BEGIN PUBLIC KEY-----\\n..."}
TOLVARIS_AGENCY_PUBLIC_KEYS_JSON=
# Optional deployed application API; Vercel SSO test site is the default web KPI target.
EGOV_API_URL=
EGOV_WEB_URL=https://egov-hackathon.vercel.app

# ── eReport ─────────────────────────────────────────────────────────────────
EREPORT_BASE_URL=https://stg-ereport-ws.oueg.info
# Dashboard name preferred; EREPORT_API_KEY still accepted
EREPORT_ACCESS_TOKEN=
# EREPORT_API_KEY=

# ── DBM Compass (X-API-Key) ─────────────────────────────────────────────────
DBM_COMPASS_BASE_URL=https://dbm-ws.oueg.info
DBM_COMPASS_API_KEY=

# ── Optional smoke overrides (pnpm smoke:platform) ───────────────────────────
# SMOKE_SSO_EXCHANGE_CODE=
# SMOKE_SSO_SCOPE=SSO_AUTHENTICATION
# SMOKE_SMS_TO=+639090000000
# SMOKE_SMS_BODY=eGov platform smoke
# SMOKE_PAY_TRANSACTION_ID=
# SMOKE_DBM_REPORT_YEAR=2026
