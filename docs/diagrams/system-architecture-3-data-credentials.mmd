flowchart TB
  Holder["Authenticated holder<br/>Android or web"]

  subgraph Department["1. Issuing department security boundary"]
    IssuerAPI["BIR / LTO / SSS / other issuer API"]
    Challenge["Issuer-specific holder challenge<br/>policy + consent + optional liveness"]
    IssuerVault["Issuer encrypted vault<br/>authoritative fields + images"]
    IssuerAPI --> Challenge
    IssuerAPI -->|"approved holder only"| IssuerVault
  end

  subgraph Chain["2. eGovChain — commitments and audit proofs"]
    Project["Public project registry"]
    Ledger["General ledger"]
    Benefit["Benefit registry"]
    Report["eReport registry"]
    Payment["Payment proof registry"]
    Document["Document proof registry"]
    Credential["Credential registry<br/>issuer + holder commitment + type + status<br/>request → decision → receipt digests"]
  end

  subgraph Protected["3. Protected off-chain data"]
    Evidence["Encrypted identity / evidence vault"]
    Analytics["Analytics read model<br/>trial balance + anomaly signals"]
    Reports["Private KPI reports<br/>no prompts, tokens, or PII"]
  end

  Holder -->|"request my ID / legal document"| IssuerAPI
  Challenge -->|"verify issuer-owned attestation<br/>tagged to this holder"| Credential
  IssuerVault -->|"holder/session-encrypted response"| Holder
  IssuerAPI -. "attestation / decision / receipt digests" .-> Credential

  Evidence -. "commitments and digests only" .-> Benefit
  Evidence -. "evidence digest only" .-> Report
  Evidence -. "payment proof only" .-> Payment
  Evidence -. "content digest only" .-> Document
  Project --> Analytics
  Ledger --> Analytics
  Analytics --> Reports

  classDef holder fill:#e0f2fe,stroke:#0369a1,color:#0c4a6e;
  classDef department fill:#f1f5f9,stroke:#475569,color:#0f172a;
  classDef private fill:#fee2e2,stroke:#b91c1c,color:#7f1d1d;
  classDef chain fill:#ecfccb,stroke:#4d7c0f,color:#365314;
  class Holder holder;
  class IssuerAPI,Challenge department;
  class IssuerVault,Evidence,Analytics,Reports private;
  class Project,Ledger,Benefit,Report,Payment,Document,Credential chain;
